# 复制为 .env 并填入你的密钥（.env 已加入 .gitignore，切勿提交）
# 全部留空 = 纯本地运行（Vosk ASR + 词典/规则文言 + Edge TTS）

# ---- 可选：OpenAI 兼容大模型（翻译 + 回答）----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ---- 可选：云端语音识别（不配置则用本地 Vosk）----
# ASR_API_KEY=

# ---- 可选：其他 TTS 服务（不配置则用 Edge TTS）----
# TTS_API_KEY=
# TTS_VOICE=zh-CN-YunxiNeural
# TTS_RATE=-10%
