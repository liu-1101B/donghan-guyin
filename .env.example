# 将本文件复制为 .env，再按使用方式填入。切勿把真实密钥提交到 Git。
# 本地模型设备、无本地模型的 Windows 电脑都可以运行此项目。

# ---- 模型后端选择 ----
# auto  = 先请求下方兼容模型服务，失败后尝试云端 API，再回退内置规则
# local = 只请求 LOCAL_LLM_BASE（可指向本机，或局域网内另一台模型服务器）
# cloud = 直接使用云端 API，不尝试本机模型（无本地大模型设备推荐）
# rules = 不请求大模型，仅用内置词典/固定规则回答
LLM_PROVIDER=auto

# ---- 本机或局域网模型服务（OpenAI 兼容 API，例如 llama-server）----
# 默认值为 http://127.0.0.1:8080/v1
# 如果模型运行在另一台 Linux 设备，可改成其局域网地址：
# LOCAL_LLM_BASE=http://192.168.1.20:8080/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=

# ---- 云端 OpenAI 兼容模型 API ----
# 取消注释并填写你所使用服务商提供的 API 根地址、模型名和密钥。
# 无本地模型设备通常设置 LLM_PROVIDER=cloud。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ---- 可选：语音服务 ----
# 本地语音识别默认使用 models/vosk-small-cn 中的 Vosk 中文模型。
# ASR_API_KEY=
# Edge TTS 需要联网；以下变量可覆盖默认音色和语速。
# TTS_API_KEY=
# TTS_VOICE=zh-CN-YunxiNeural
# TTS_RATE=-10%
