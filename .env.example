# 可选：高质量大模型 API。没有填写密钥时，机器人使用本地词典模式。
# API 模式选择在机器人界面里完成，并记住上次选择（保存在被 .gitignore 忽略的 .robot_preferences.json）。
# 不要把真实密钥提交到 Git。

# OpenAI 兼容 Chat Completions API
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 可选：云端语音识别（默认使用本地 Vosk 中文模型）
# ASR_API_KEY=

# 自然语音合成（Edge TTS，需要联网）
# TTS_VOICE=zh-CN-YunxiNeural
# TTS_RATE=-10%
